DATABASE_URL=sqlite+aiosqlite:///./anima.db
CHROMA_PATH=./chroma_db

# Ollama (local, sem API key)
OLLAMA_BASE_URL=http://localhost:11434/v1
# 16GB RAM → llama3.1:8b  |  8GB RAM → phi3:mini ou llama3.2:3b
OLLAMA_MODEL=qwen2.5:7b

# opcional — ajuste fino do RAG
RAG_CONFIDENCE_THRESHOLD=0.72
RAG_TOP_K=5
QUESTION_DEDUP_THRESHOLD=0.90
