DATABASE_URL=sqlite+aiosqlite:///./anima.db
CHROMA_PATH=./chroma_db

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
# 16 GB RAM → qwen2.5:7b  |  8 GB RAM → qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Language for all AI-generated content (answers, docs titles, topics)
# Examples: Portuguese, English, Spanish
ANIMA_LANGUAGE=Portuguese

# Web search — enriches documentation with public context when a Q&A is ingested.
# Without a key, uses DuckDuckGo (no setup). With a key, uses Brave Search API
# (more reliable; 2 000 free queries/month → https://brave.com/search/api/).
# Set WEB_SEARCH_ENABLED=false to disable entirely.
WEB_SEARCH_ENABLED=true
# BRAVE_API_KEY=your_key_here

# RAG fine-tuning (optional)
RAG_CONFIDENCE_THRESHOLD=0.60
RAG_TOP_K=5
QUESTION_DEDUP_THRESHOLD=0.90
