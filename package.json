{
  "name": "anima",
  "version": "0.1.0",
  "description": "A collective knowledge base powered by AI",
  "private": true,
  "type": "module",
  "bin": {
    "anima": "./scripts/anima.mjs"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "stop":  "node scripts/stop.mjs",
    "api":   "cd api && python -m uvicorn anima.main:app --reload --reload-dir anima",
    "web":   "cd web && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
